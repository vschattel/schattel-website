---
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://schattel.at").href;
---
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Mag. Volker Schattel" />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:image" content="https://schattel.at/og-image.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<script defer data-domain="schattel.at" src="https://plausible.io/js/script.js"></script>
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Schattel",
  legalName: "Mag. Volker Schattel – Unternehmensberatung",
  url: "https://schattel.at",
  founder: { "@type": "Person", name: "Mag. Volker Schattel" },
  areaServed: ["AT", "DE", "CH"],
  sameAs: ["https://lohnlotsen.at"]
})} />
<style is:global>
  :root{
    --papier:#F4F2ED; --flaeche:#FDFCF9; --ink:#17191E; --soft:#565B63;
    --line:#E3E0D8; --radius:12px;
    --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
    --serif:Georgia,"Times New Roman",serif;
    --accent:#9A671F; --accent-soft:#F3EBDD; --dunkel:#111216;
  }
  *{box-sizing:border-box;margin:0}
  body{font-family:var(--sans);background:var(--papier);color:var(--ink);line-height:1.65;font-size:17px}
  .wrap{max-width:1120px;margin:0 auto;padding:0 28px}
  .kicker{font-size:12px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--soft);display:flex;align-items:center;gap:8px}
  .kicker::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--accent)}
  h1{font-size:clamp(38px,5.4vw,60px);line-height:1.08;letter-spacing:-.02em;font-weight:650;margin:18px 0 20px}
  h2{font-size:clamp(27px,3.4vw,38px);line-height:1.15;letter-spacing:-.015em;font-weight:650;margin-bottom:14px}
  h3{font-size:19px;font-weight:650}
  .em{font-family:var(--serif);font-style:italic;font-weight:400;color:var(--accent)}
  p.lead{font-size:19px;color:var(--soft);max-width:58ch}
  a{color:inherit}
  .btn{display:inline-block;padding:13px 28px;border-radius:999px;font-size:13px;font-weight:650;letter-spacing:.07em;text-transform:uppercase;text-decoration:none;border:1.5px solid var(--ink);color:var(--ink)}
  .btn.primaer{background:var(--ink);color:#fff}
  .btn.hell{border-color:#fff;color:var(--ink);background:#fff}
  section{padding:84px 0}
  header.site{border-bottom:1px solid var(--line);background:var(--papier)}
  header.site .wrap{display:flex;align-items:center;justify-content:space-between;height:76px}
  .marke{font-size:21px;letter-spacing:-.01em;text-decoration:none;color:var(--ink);display:flex;align-items:center;gap:11px;line-height:1.2}
  .marke img{width:36px;height:auto;display:block;flex:none}
  .marke b{font-weight:700;display:block}
  .marke span{display:block;font-weight:400;color:var(--soft);font-size:12px;letter-spacing:.01em}
  footer.familie img.zeichen{width:20px;height:auto;vertical-align:-5px;margin-right:6px}
  nav.main a{color:var(--soft);text-decoration:none;font-size:15px;font-weight:500;margin-left:26px}
  .hairline{border:none;border-top:1px solid var(--line);margin:0}
  .liste{border-left:1px solid #C9C5BB}
  .liste .zeile{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:20px 0 20px 24px;border-bottom:1px solid var(--line);position:relative}
  .liste .zeile span{flex:0 0 44%;text-align:right}
  .liste .zeile::before{content:"";position:absolute;left:-3.5px;top:28px;width:6px;height:6px;border-radius:50%;background:var(--ink)}
  .karte{background:var(--flaeche);border:1px solid var(--line);border-radius:var(--radius);padding:30px}
  .grid{display:grid;gap:20px}
  .foto{border-radius:var(--radius);display:block;width:100%;height:auto}
  .sw{filter:grayscale(1) contrast(1.04)}
  .tag{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);border:1px solid var(--accent);border-radius:999px;padding:3px 12px}
  footer.familie{border-top:1px solid var(--line);padding:34px 0;font-size:14px;color:var(--soft)}
  footer.familie .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}
  footer.familie a{color:var(--soft)}
  /* Mobile-Navigation (CSS-only, analog Lohnlotsen) */
  .mnav{display:none;position:relative}
  .mnav summary{list-style:none;cursor:pointer;font-size:26px;line-height:1;padding:6px}
  .mnav summary::-webkit-details-marker{display:none}
  .mnav .menu{position:absolute;right:0;top:44px;background:var(--flaeche);border:1px solid var(--line);border-radius:var(--radius);padding:10px 0;min-width:210px;box-shadow:0 10px 30px rgba(23,25,30,.08);z-index:50}
  .mnav .menu a{display:block;padding:11px 20px;text-decoration:none;color:var(--ink);font-size:16px}
  @media(max-width:820px){
    nav.main{display:none}
    .mnav{display:block}
    .zwei{grid-template-columns:1fr!important}
    .liste .zeile{flex-direction:column;align-items:flex-start;gap:4px}
    .liste .zeile span{flex:none;text-align:left}
    section{padding:56px 0}
  }
</style>
</head>
<body>

<header class="site">
  <div class="wrap">
    <a class="marke" href="/"><img src="/assets/zeichen-schattel.svg" alt="Schattel" width="64" height="70" /><div><b>Schattel</b><span>Volker Schattel · Unternehmensberatung</span></div></a>
    <nav class="main">
      <a href="/projekte/">Projekte</a>
      <a href="/ueber/">Über uns</a>
      <a class="btn primaer" style="padding:10px 22px;margin-left:26px" href="https://calendly.com/volkerschattel/schattel-at-erstberatung" rel="noopener">Erstgespräch</a>
    </nav>
    <details class="mnav">
      <summary aria-label="Menü">☰</summary>
      <div class="menu">
        <a href="/projekte/">Projekte</a>
        <a href="/ueber/">Über uns</a>
        <a href="https://calendly.com/volkerschattel/schattel-at-erstberatung" rel="noopener">Erstgespräch buchen</a>
      </div>
    </details>
  </div>
</header>

<slot />

<footer class="familie">
  <div class="wrap">
    <div><img class="zeichen" src="/assets/zeichen-schattel.svg" alt="" aria-hidden="true" width="64" height="70" />© 2026 Schattel · Mag. Volker Schattel · Unternehmensberatung · <a href="/impressum-datenschutz/">Impressum &amp; Datenschutz</a></div>
    <div>Unsere Payroll-Marke: <strong>LohnLotsen</strong> → <a href="https://lohnlotsen.at" rel="noopener">lohnlotsen.at</a></div>
  </div>
</footer>

</body>
</html>
