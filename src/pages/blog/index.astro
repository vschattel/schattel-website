---
import Base from "../../layouts/Base.astro";
const posts = Object.values(import.meta.glob("./*.md", { eager: true })).sort(
  (a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()
);
const fmt = (d) => new Date(d).toLocaleDateString("de-AT", { day: "2-digit", month: "2-digit", year: "numeric" });
// TODO vor dem ersten Artikel: noindex entfernen + „Blog" in die Navigation (Base.astro, nav.main + .mnav)
const noindex = posts.length === 0;
---
<Base title="Blog | Schattel" description="Aus der Umsetzung: Restrukturierung, kaufmännische Führung, Recruiting und KI in KMU – Erfahrungen und Systeme, die im eigenen Betrieb laufen." noindex={noindex}>
  <section>
    <div class="wrap" style="max-width:820px">
      <div class="kicker">Blog</div>
      <h1 style="font-size:clamp(30px,4vw,42px)">Aus der <span class="em">Umsetzung.</span></h1>
      <p class="lead">Was wir in Mandaten und im eigenen Betrieb bauen – Führung, Finanzen, Personal, KI. Keine Theorie, sondern Systeme, die laufen.</p>
      {posts.length === 0 ? (
        <p style="margin-top:36px;color:var(--soft)">Erste Beiträge folgen in Kürze.</p>
      ) : (
        <div style="margin-top:36px;display:grid;gap:18px">
          {posts.map((p) => (
            <a class="karte" style="text-decoration:none;color:inherit" href={p.url + "/"}>
              <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap">
                <span class="tag">{p.frontmatter.kategorie}</span>
                <span style="font-size:13px;color:var(--soft)">{fmt(p.frontmatter.date)}</span>
              </div>
              <h3 style="margin-top:12px">{p.frontmatter.title}</h3>
              <p style="color:var(--soft);font-size:15px;margin-top:6px">{p.frontmatter.description}</p>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
