---
import Base from "../layouts/Base.astro";
---
<Base title="Seite nicht gefunden | Schattel" description="Diese Seite gibt es nicht. Zur Startseite von Schattel – Unternehmensberatung mit Umsetzung statt Beratung für KMU im DACH-Raum.">
<section style="padding:110px 0">
  <div class="wrap" style="max-width:720px;text-align:center">
    <div class="kicker" style="justify-content:center">404</div>
    <h1 style="font-size:clamp(30px,4vw,44px)">Diese Seite gibt es <span class="em">nicht.</span></h1>
    <p class="lead" style="margin:14px auto 0;max-width:46ch">Vielleicht ist die Adresse umgezogen – das Wichtigste finden Sie hier:</p>
    <div style="margin-top:30px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a class="btn primaer" href="/">Zur Startseite</a>
      <a class="btn" href="/projekte/">Zu den Projekten</a>
    </div>
  </div>
</section>
</Base>
